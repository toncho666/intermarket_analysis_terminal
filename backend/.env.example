# Application
APP_NAME=Intermarket Analysis Terminal
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intermarket
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# Data Sources
FRED_API_KEY=your-fred-api-key-here
# Get free at: https://fred.stlouisfed.org/docs/api/api_key.html

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot

# JWT Auth
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cache TTL (seconds)
CACHE_TTL_PRICES=300
CACHE_TTL_CORRELATIONS=3600
CACHE_TTL_REGIME=600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
