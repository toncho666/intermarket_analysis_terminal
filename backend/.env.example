# Application
APP_NAME=Intermarket Analysis Terminal
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intermarket
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/intermarket

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Data Sources
# Get your FRED API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Telegram Notifications
# 1. Create bot via @BotFather on Telegram
# 2. Get bot token from @BotFather
# 3. Send /start to your bot
# 4. Get your chat_id from @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Calculation Settings
DEFAULT_CORR_WINDOWS=[20,60,250]
ANOMALY_Z_THRESHOLD=2.0
COINT_P_VALUE_THRESHOLD=0.05
